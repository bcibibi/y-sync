{
  "name": "@bcibibi/y-react",
  "version": "1.0.2",
  "description": "React components for syncing Yjs documents over WebSockets connections. This package is part of the y-sync project.",
  "keywords": [
    "yjs",
    "react",
    "sync",
    "collaboration"
  ],
  "homepage": "https://github.com/bcibibi/y-sync/tree/main/react#readme",
  "bugs": {
    "url": "https://github.com/bcibibi/y-sync/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcibibi/y-sync.git"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "npm run pre-build && concurrently \"vite\" \"npm run backend\"",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:dist-types": "node -e \"const fs=require('node:fs'); fs.mkdirSync('dist/cjs',{recursive:true}); fs.writeFileSync('dist/cjs/package.json', '{\\n  \\\"type\\\": \\\"commonjs\\\"\\n}\\n'); fs.mkdirSync('dist/esm',{recursive:true}); fs.writeFileSync('dist/esm/package.json', '{\\n  \\\"type\\\": \\\"module\\\"\\n}\\n');\"",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:dist-types",
    "lint": "eslint .",
    "preview": "vite preview",
    "pre-build": "cd .. && npm run build",
    "backend": "DEBUG=\"y-utils:convert,y-utils:override\" node './backend.js'"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "fast-deep-equal": "^3.1.3",
    "@bcibibi/y-sync-client": "^1.0.1",
    "@bcibibi/y-utils": "^1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@types/debug": "^4.1.13",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "wait-on": "^9.0.10",
    "@bcibibi/y-sync-server": "^1.0.1"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yjs": "^13.6.31"
  }
}
