{
  "name": "YSync Dev Container",
  "dockerComposeFile": "./docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "runServices": [
    "dev",
    "redis",
    "mongodb"
  ],
  "forwardPorts": [5173],
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vitest.explorer",
        "ms-azuretools.vscode-containers"
      ]
    }
  }
}